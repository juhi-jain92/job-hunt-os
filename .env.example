# Copy this file to .env and fill in your own API keys.
# Never commit .env — it is in .gitignore.

# RapidAPI key for JSearch (job aggregation across LinkedIn, Indeed, ZipRecruiter, Glassdoor)
# Get yours at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# Apify token for Wellfound scraper and VC portfolio jobs actor
# Get yours at: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# ZhipuAI API key for the GLM match scorer
# Get yours at: https://bigmodel.cn → API Keys
ZAI_API_KEY=your_zai_api_key_here

# Google account that should receive editor access to the generated sheet.
GOOGLE_SHEET_OWNER_EMAIL=your@email.com
