# Copy this file to .env and fill in your own API keys.
# Never commit .env — it is in .gitignore.

# RapidAPI key for JSearch (job aggregation across LinkedIn, Indeed, ZipRecruiter, Glassdoor)
# Get yours at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# Apify token for Wellfound scraper and VC portfolio jobs actor
# Get yours at: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Anthropic API key for the LLM match scorer and draft generator
# Get yours at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hunter.io key — finds named people and email patterns at target companies.
# Optional, but without it networking_daily.py can only produce LinkedIn
# search links, and those consume the 15/week connection-request cap.
# Free tier is 25 domain searches/month. Get yours at:
# https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key_here
